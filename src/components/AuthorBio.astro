---
import { AUTHOR_NAME, AUTHOR_ROLE, AUTHOR_BIO } from "../consts";
---

<aside class="mt-16 rounded-xl border border-line bg-surface p-6">
  <p class="font-mono text-xs uppercase tracking-wide text-ink-soft">Sobre quem escreve</p>
  <p class="mt-2 font-display text-lg font-semibold text-ink">{AUTHOR_NAME}</p>
  <p class="text-sm text-ink-muted">{AUTHOR_ROLE}</p>
  <p class="mt-3 text-ink-muted">{AUTHOR_BIO}</p>
  <a href="/sobre" class="mt-3 inline-block text-sm">Ler mais sobre o autor →</a>
</aside>
