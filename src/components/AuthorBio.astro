---
import { Image } from "astro:assets";
import { AUTHOR_NAME, AUTHOR_ROLE, AUTHOR_BIO } from "../consts";
import emilianoPhoto from "../assets/emiliano.png";
---

<aside class="mt-16 flex gap-4 rounded-xl border border-line bg-surface p-6">
  <Image
    src={emilianoPhoto}
    alt={AUTHOR_NAME}
    width={56}
    height={56}
    class="h-14 w-14 shrink-0 rounded-full border border-line object-cover grayscale"
  />
  <div>
    <p class="font-mono text-xs uppercase tracking-wide text-ink-soft">Sobre quem escreve</p>
    <p class="mt-1 font-display text-lg font-semibold text-ink">{AUTHOR_NAME}</p>
    <p class="text-sm text-ink-muted">{AUTHOR_ROLE}</p>
    <p class="mt-3 text-ink-muted">{AUTHOR_BIO}</p>
    <a href="/sobre" class="mt-3 inline-block text-sm">Ler mais sobre o autor →</a>
  </div>
</aside>
