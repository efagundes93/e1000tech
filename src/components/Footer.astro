---
import { SITE_TITLE, AUTHOR_NAME, SOCIAL_LINKS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-3xl flex-col gap-3 px-6 py-10 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {SITE_TITLE} — {AUTHOR_NAME}. Todos os direitos reservados.</p>
    <div class="flex gap-4">
      <a href={SOCIAL_LINKS.github} class="no-underline hover:underline" target="_blank" rel="me noopener noreferrer">GitHub</a>
      <a href={SOCIAL_LINKS.linkedin} class="no-underline hover:underline" target="_blank" rel="me noopener noreferrer">LinkedIn</a>
      <a href="/rss.xml" class="no-underline hover:underline">RSS</a>
    </div>
  </div>
</footer>
