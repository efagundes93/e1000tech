---
import { SITE_TITLE, AUTHOR_NAME, SOCIAL_LINKS } from "../consts";

const year = new Date().getFullYear();
---

<!--
  O rodapé fica sempre no "ink" escuro do Kikwiflow, independente do tema
  ativo na página — mesmo traço de marca usado na documentação do produto.
-->
<footer class="mt-24" style="background-color: #020817;">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-10 text-sm sm:flex-row sm:items-center sm:justify-between"
    style="color: #94a3b8;"
  >
    <p>© {year} {SITE_TITLE} — {AUTHOR_NAME}. Todos os direitos reservados.</p>
    <div class="flex gap-4">
      <a
        href={SOCIAL_LINKS.github}
        class="no-underline hover:underline"
        style="color: #94a3b8;"
        target="_blank"
        rel="me noopener noreferrer">GitHub</a
      >
      <a
        href={SOCIAL_LINKS.linkedin}
        class="no-underline hover:underline"
        style="color: #94a3b8;"
        target="_blank"
        rel="me noopener noreferrer">LinkedIn</a
      >
      <a href="/rss.xml" class="no-underline hover:underline" style="color: #94a3b8;">RSS</a>
    </div>
  </div>
</footer>
