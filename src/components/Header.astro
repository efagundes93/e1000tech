---
import { SITE_TITLE, NAV_LINKS } from "../consts";

const { pathname } = Astro.url;
---

<header class="border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5">
    <a
      href="/"
      class="font-serif text-xl font-semibold tracking-tight text-ink no-underline"
    >
      {SITE_TITLE}<span class="text-accent">.</span>
    </a>
    <nav class="flex items-center gap-6 text-sm">
      {
        NAV_LINKS.map((link) => {
          const active = pathname === link.href || pathname.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              class:list={[
                "font-sans no-underline transition-colors",
                active ? "text-accent font-medium" : "text-ink-muted hover:text-ink",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href="/rss.xml"
        class="font-sans text-ink-muted no-underline transition-colors hover:text-ink"
        aria-label="RSS feed"
        title="RSS feed"
      >
        RSS
      </a>
    </nav>
  </div>
</header>
