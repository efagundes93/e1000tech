---
import type { CollectionEntry } from "astro:content";
import { estimateReadingTime } from "../lib/readingTime";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const readingMinutes = estimateReadingTime(post.body ?? "");

const formattedDate = pubDate.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<article class="group border-b border-line py-8 first:pt-0 last:border-b-0">
  <a href={`/blog/${post.id}`} class="no-underline">
    <h2 class="font-serif text-2xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
      {title}
    </h2>
  </a>
  <p class="mt-2 font-mono text-xs uppercase tracking-wide text-ink-soft">
    {formattedDate} · {readingMinutes} min de leitura
  </p>
  <p class="mt-3 text-ink-muted">{description}</p>
  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="font-mono text-xs text-ink-soft">#{tag}</span>
      ))}
    </div>
  )}
</article>
