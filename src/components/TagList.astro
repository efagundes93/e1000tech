---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = "" } = Astro.props;
---

<ul class:list={["flex flex-wrap gap-2", className]}>
  {
    tags.map((tag) => (
      <li>
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          class="inline-block rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-ink-muted no-underline transition-colors hover:border-accent hover:text-accent"
        >
          #{tag}
        </a>
      </li>
    ))
  }
</ul>
