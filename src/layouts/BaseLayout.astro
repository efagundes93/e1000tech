---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  updatedTime?: Date;
  tags?: string[];
  /** Posts usam um main mais largo para que código/diagramas/mídia possam
   * "estourar" a coluna de leitura — ver o grid em .prose no global.css —
   * e para sobrar espaço lateral pro índice fixo (ver .post-grid). */
  wide?: boolean;
}

const { title, description, image, type, publishedTime, updatedTime, tags, wide = false } =
  Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      tags={tags}
    />
    <script is:inline>
      // Aplica o tema salvo (ou o do sistema) antes do primeiro paint, pra
      // não piscar claro→escuro. O toggle mora no Header.
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("e1000-theme");
        } catch (e) {}
        if (saved === "light" || saved === "dark") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <div class="brand-hairline"></div>
    <main class:list={["mx-auto w-full flex-1 px-6 py-12", wide ? "max-w-7xl" : "max-w-3xl"]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
