---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";
import AuthorBio from "../components/AuthorBio.astro";
import { estimateReadingTime } from "../lib/readingTime";

interface Props {
  post: CollectionEntry<"blog">;
  prevPost?: CollectionEntry<"blog">;
  nextPost?: CollectionEntry<"blog">;
}

const { post, prevPost, nextPost } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const readingMinutes = estimateReadingTime(post.body ?? "");

const formattedDate = pubDate.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/${post.id}.png`}
  type="article"
  publishedTime={pubDate}
  updatedTime={updatedDate}
  tags={tags}
>
  <article>
    <header class="mb-10">
      <p class="font-mono text-xs uppercase tracking-wide text-ink-soft">
        {formattedDate} · {readingMinutes} min de leitura
      </p>
      <h1 class="mt-3 font-serif text-4xl font-bold leading-tight text-ink sm:text-5xl">
        {title}
      </h1>
      <p class="mt-4 text-lg text-ink-muted">{description}</p>
      {tags.length > 0 && <TagList tags={tags} class="mt-5" />}
    </header>

    <div
      class="prose prose-neutral max-w-none
             prose-headings:font-serif prose-headings:font-semibold prose-headings:text-ink
             prose-p:text-ink prose-p:leading-relaxed
             prose-a:text-accent prose-a:no-underline prose-a:decoration-accent/40 hover:prose-a:underline
             prose-strong:text-ink
             prose-blockquote:border-accent prose-blockquote:text-ink-muted
             prose-code:font-mono prose-code:text-ink prose-code:before:content-none prose-code:after:content-none
             prose-pre:bg-code prose-pre:border prose-pre:border-line
             prose-hr:border-line
             prose-img:rounded-lg prose-img:border prose-img:border-line"
    >
      <slot />
    </div>

    <AuthorBio />

    {
      (prevPost || nextPost) && (
        <nav class="mt-12 grid grid-cols-1 gap-4 border-t border-line pt-8 sm:grid-cols-2">
          {prevPost && (
            <a href={`/blog/${prevPost.id}`} class="no-underline">
              <p class="font-mono text-xs uppercase tracking-wide text-ink-soft">← Anterior</p>
              <p class="mt-1 font-serif text-ink transition-colors hover:text-accent">
                {prevPost.data.title}
              </p>
            </a>
          )}
          {nextPost && (
            <a
              href={`/blog/${nextPost.id}`}
              class:list={["no-underline", !prevPost && "sm:col-start-2 sm:text-right"]}
            >
              <p class="font-mono text-xs uppercase tracking-wide text-ink-soft">Próximo →</p>
              <p class="mt-1 font-serif text-ink transition-colors hover:text-accent">
                {nextPost.data.title}
              </p>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
